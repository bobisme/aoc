# Justfile for Advent of Code

# Run a day: just run 2015 1
run year day:
    #!/usr/bin/env bash
    set -euo pipefail
    
    padded=$(printf "%02d" {{day}})
    base="{{year}}-${padded}"
    
    if [[ -f "${base}.rs" ]]; then
        rustc -O "${base}.rs" -o "/tmp/${base}"
        "/tmp/${base}"
    elif [[ -f "${base}.zig" ]]; then
        zig build-exe "${base}.zig" -O ReleaseFast --name "${base}" 2>/dev/null
        "./${base}"
        rm -f "${base}" "${base}.o"
    elif [[ -f "${base}.py" ]]; then
        python "${base}.py"
    else
        echo "No solution found for ${base}"
        exit 1
    fi

# Shorthand for current year work
day day:
    just run 2015 {{day}
